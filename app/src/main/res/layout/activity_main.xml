<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="Logout"
        android:textColor="#222222"
        android:background="@android:color/transparent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:stateListAnimator="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/open_weather"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Weather"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/round_black_btn"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="60dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/main_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/google_maps"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Google Maps"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/round_black_btn"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/open_weather"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/go_to_history"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="History"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/round_black_btn"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/google_maps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
