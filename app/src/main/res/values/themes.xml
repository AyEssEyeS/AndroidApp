<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Textron0" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Neutral white background everywhere -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/blue_dark</item>

        <!-- Disable default tinting for Material buttons -->
        <item name="materialButtonStyle">@style/NoTintButton</item>
        <item name="buttonStyle">@style/NoTintButton</item>

    </style>

    <style name="NoTintButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
